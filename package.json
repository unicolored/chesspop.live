{
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check-format": "oxfmt --check",
    "deploy": "mise run deploy",
    "ng": "ng",
    "dev": "rm -rf .angular/cache/*/chesspop.live/vite && ng serve chesspop.live --no-hmr --ssl --ssl-cert localhost.pem --ssl-key localhost-key.pem",
    "dist": "ng build --configuration production && mv dist/app/browser/index.csr.html dist/app/browser/index.html",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "serve:ssr:chesspop.live": "node dist/app/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.4",
    "@lichess-org/chessground": "^10.5.0",
    "@lucide/angular": "^1.62.0",
    "chess.js": "^1.4.0",
    "chessfield": "^2.5.5",
    "express": "^4.22.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/express": "^4.17.25",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^26.6.5",
    "daisyui": "^5.7.50",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "wrangler": "^4.154.0"
  },
  "packageManager": "pnpm@12.15.0"
}
